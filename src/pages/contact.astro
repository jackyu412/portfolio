---
import Layout from "../layouts/Layout.astro";
import SectionPanel from "../components/SectionPanel.astro";
---

<Layout title="Jack Yu">
  <div class="content-wrapper">
    <SectionPanel id="contact">
      <h2>Contact</h2>
      <p>Click the button below to reveal my email address.</p>

      <button id="reveal-email" class="button">Reveal email</button>
      <div id="email-output" aria-live="polite" style="margin-top: 1rem;"></div>
    </SectionPanel>
  </div>

  <script is:inline>
    const revealButton = document.getElementById("reveal-email");
    const emailOutput = document.getElementById("email-output");

    if (revealButton && emailOutput) {
      revealButton.addEventListener("click", () => {
        const user = atob("amFja3l1");
        const domain = atob("Y2FsdGVjaC5lZHU=");
        const email = `${user}@${domain}`;

        const link = document.createElement("a");
        link.href = `mailto:${email}`;
        link.textContent = email;
        link.style.color = "dodgerblue";
        link.style.textDecoration = "underline";

        emailOutput.innerHTML = "";
        emailOutput.appendChild(link);
        revealButton.style.display = "none";
      });
    }
  </script>
</Layout>
