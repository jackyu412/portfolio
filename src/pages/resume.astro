---
import Layout from "../layouts/Layout.astro";
import SectionPanel from "../components/SectionPanel.astro";
---

<Layout
  title="Resume | Jack Yu"
  description="Download or view the resume of Jack Yu"
>
  <div class="content-wrapper">
    <SectionPanel id="resume">
      <h2>Resume</h2>
      <p>
        Click the button below to load the resume preview, or <a
          id="download-link"
          href="/documents/resume_26.pdf"
          download
          style="color: dodgerblue; text-decoration: underline;"
          >download here</a
        >.
      </p>

      <button id="load-resume" class="button">Load resume</button>
      <div id="resume-container" style="margin-top: 1.5rem;"></div>
    </SectionPanel>
  </div>

  <script is:inline>
    const loadResumeButton = document.getElementById("load-resume");
    const resumeContainer = document.getElementById("resume-container");
    const resumeUrl = atob("L2RvY3VtZW50cy9yZXN1bWVfMjYucGRm");

    if (loadResumeButton && resumeContainer) {
      loadResumeButton.addEventListener("click", () => {
        const wrapper = document.createElement("div");
        wrapper.style.display = "flex";
        wrapper.style.justifyContent = "center";

        const iframe = document.createElement("iframe");
        iframe.src = resumeUrl;
        iframe.width = "100%";
        iframe.height = "800";
        iframe.title = "Resume PDF";
        iframe.loading = "lazy";
        iframe.style.border = "1px solid #ccc";
        iframe.style.maxWidth = "850px";
        iframe.style.borderRadius = "0.5rem";

        wrapper.appendChild(iframe);
        resumeContainer.innerHTML = "";
        resumeContainer.appendChild(wrapper);
        loadResumeButton.style.display = "none";
      });
    }
  </script>
</Layout>
