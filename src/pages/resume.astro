---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Resume | Jack Yu"
  description="Resume of Jack Yu, Caltech physics student."
  gain={0}
  noIndex={true}
>
  <article class="resume-page">
    <header class="resume-header">
      <h1>Jack Yu</h1>
      <p>B.S. Physics · California Institute of Technology</p>
    </header>

    <section class="resume-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <h3>California Institute of Technology</h3>
          <time datetime="2029-06">Expected June 2029</time>
        </div>
        <p class="resume-entry-subtitle">
          B.S. in Physics · Pasadena, CA · GPA: 4.1 · Sophomore
        </p>
        <p>
          <strong>Coursework:</strong> Quantum Mechanics, Electromagnetism, Classical
          Mechanics, Linear Algebra, Abstract Algebra, Statistical Mechanics, Differential
          Equations, Multivariable Calculus.
        </p>
      </article>
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <h3>Albuquerque Academy</h3>
          <span
            ><time datetime="2020">2020</time>–<time datetime="2025">2025</time
            ></span
          >
        </div>
        <p class="resume-entry-subtitle">Albuquerque, NM</p>
      </article>
    </section>

    <section class="resume-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <h3>William N. Lacey SURF Research Fellow · Cushing Lab</h3>
          <time datetime="2026">Summer 2026</time>
        </div>
        <p class="resume-entry-subtitle">Caltech · Pasadena, CA</p>
        <ul>
          <li>
            Designed and integrated a thermoelectric temperature-controlled
            stage for Laser-driven Ultrafast Impedance Spectroscopy (LUIS),
            enabling temperature-dependent studies of phonon-mediated ion
            transport.
          </li>
          <li>
            Modeled lattice anharmonicity in Na<sub>3</sub>PS<sub>4</sub> using density
            functional theory (DFT) to investigate ion transport mechanisms.
          </li>
        </ul>
      </article>
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <h3>Student Researcher · Experimental Gravity Group (EGG)</h3>
          <span><time datetime="2026-01">Jan 2026</time>–Present</span>
        </div>
        <p class="resume-entry-subtitle">Caltech · Pasadena, CA</p>
        <ul>
          <li>
            Designed and simulated experimentally viable non-Gaussian photonic
            quantum states using Strawberry Fields (TensorFlow backend) and
            QuTiP.
          </li>
          <li>
            Formulated and optimized high-dimensional optical circuit parameters
            for multi-mode beam splitter and squeezer networks under realistic
            photon-loss and noise models.
          </li>
          <li>
            Used Caltech's high-performance computing cluster to parallelize
            computationally intensive parameter searches and fidelity
            evaluations.
          </li>
        </ul>
      </article>
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <h3>
            Optoelectronics Intern · Sandia National Laboratories, III-V
            Photonics Center
          </h3>
          <span
            ><time datetime="2024-06">Jun 2024</time>–<time datetime="2025-09"
              >Sep 2025</time
            ></span
          >
        </div>
        <p class="resume-entry-subtitle">Albuquerque, NM</p>
        <ul>
          <li>
            Conducted DARPA H6 research developing a piezo-tunable etalon for
            chip-scale atomic clocks.
          </li>
          <li>
            Characterized VCSELs using probe-station measurements and device
            modeling to optimize laser performance.
          </li>
        </ul>
      </article>
    </section>

    <section class="resume-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Projects</h2>
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <h3>Hexagonal Non-Gaussian State Generation</h3>
          <time datetime="2026">2026</time>
        </div>
        <p class="resume-entry-subtitle">
          Caltech EGG · Python, QuTiP, Strawberry Fields
        </p>
        <ul>
          <li>
            Designed and optimized multi-mode photonic circuits to generate a
            target non-Gaussian quantum state.
          </li>
          <li>
            Parameterized circuit architecture, squeezing profiles, and mode
            allocations to maximize fidelity under photon loss.
          </li>
          <li>
            Implemented high-dimensional numerical optimization and large-scale
            quantum-state simulations in Python.
          </li>
        </ul>
      </article>
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <h3>External Cavity Diode Laser (ECDL) System</h3>
          <span
            ><time datetime="2024">2024</time>–<time datetime="2025">2025</time
            ></span
          >
        </div>
        <p class="resume-entry-subtitle">
          Sandia National Laboratories · SolidWorks, Python
        </p>
        <ul>
          <li>
            Designed and constructed a Littman–Metcalf ECDL for
            antireflection-coating characterization and machined custom mounts.
          </li>
          <li>
            Developed protocols for frequency-stability and mode-hop-free tuning
            characterization; modeled vacuum-compatible optomechanical
            components in SolidWorks.
          </li>
        </ul>
      </article>
    </section>

    <section class="resume-section" aria-labelledby="publication-heading">
      <h2 id="publication-heading">Publication</h2>
      <p class="resume-publication">
        D. K. Serkland, A. J. Grine, P.-S. Wong, <strong>Jack Yu</strong>.
        “Noise Characterization of VCSELs for Atomic Clocks and Magnetometers.” <em
          >Proceedings of SPIE</em
        >, Vol. PC13911, Vertical-Cavity Surface-Emitting Lasers XXX, 2026. <a
          href="https://doi.org/10.1117/12.3082136">doi:10.1117/12.3082136</a
        >.
      </p>
    </section>

    <section class="resume-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Technical skills</h2>
      <dl class="resume-skills">
        <div>
          <dt>Programming &amp; tools</dt><dd>
            Python, Java, Git, LaTeX, MATLAB
          </dd>
        </div>
        <div>
          <dt>Quantum simulation</dt><dd>
            QuTiP, Strawberry Fields, PennyLane, numerical optimization
          </dd>
        </div>
        <div>
          <dt>Scientific computing</dt><dd>
            NumPy, SciPy, PyTorch, TensorFlow, DFT (Quantum ESPRESSO)
          </dd>
        </div>
        <div>
          <dt>Engineering &amp; CAD</dt><dd>
            SolidWorks, KiCad, PCB design, 3D printing, manual machining, wire
            bonding
          </dd>
        </div>
        <div>
          <dt>Experimental laboratory</dt><dd>
            Optical alignment, laser characterization, probe station
          </dd>
        </div>
      </dl>
    </section>

    <section class="resume-section" aria-labelledby="awards-heading">
      <h2 id="awards-heading">Selected awards</h2>
      <ul>
        <li>
          <strong>AIME qualifier</strong> · American Mathematics Invitational Examination
        </li>
        <li>
          <strong>NISCA All-American</strong> · Top 100 in the U.S., 200 Medley Relay
          · <time datetime="2025-06">June 2025</time>
        </li>
      </ul>
    </section>

    <section class="resume-section" aria-labelledby="activities-heading">
      <h2 id="activities-heading">Extracurriculars</h2>
      <div class="resume-entry">
        <div class="resume-entry-heading">
          <h3>NCAA Division III Varsity Swim Team · Caltech</h3>
          <span><time datetime="2025">2025</time>–Present</span>
        </div>
        <div class="resume-entry-heading">
          <h3>Chamber Music Ensemble (Piano) · Caltech</h3>
          <span>Present</span>
        </div>
      </div>
    </section>

    <button class="resume-download" type="button">download pdf</button>
  </article>
</Layout>
