---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Jack Yu – Resume"
  description="Download or view the resume of Jack Yu "
>
  <div class="content-wrapper">
    <section class="block" id="resume">
      <h2>Resume</h2>
      <p>Click the button below to reveal my current resume.</p>

      <!-- Toggle button -->
      <p style="text-align: center;">
        <span
          id="resume-toggle"
          onclick="
            const resume = document.getElementById('resume-content');
            resume.style.display = resume.style.display === 'block' ? 'none' : 'block';
          "
          onmouseenter="
            this.style.transform = 'translateY(-1px)';
            this.style.opacity = '0.7';
          "
          onmouseleave="
            this.style.transform = 'translateY(0)';
            this.style.opacity = '1';
          "
          style="
            cursor: pointer;
            color: dodgerblue;
            font-style: italic;
            transition: all 0.2s ease;
            display: inline-block;
          "
        >
          Click to reveal resume
        </span>
      </p>

      <!-- Hidden resume content -->
      <div id="resume-content" style="display: none; margin-top: 1rem;">
        <!-- Embedded PDF viewer -->
        <div style="display: flex; justify-content: center;">
          <iframe
            src="/documents/JackYu_Resume2.pdf"
            width="100%"
            height="600"
            style="border: 1px solid #ccc; max-width: 850px; border-radius: 0.5rem;"
            title="Resume PDF"
            loading="lazy"></iframe>
        </div>

        <!-- Download link -->
        <p style="text-align: center; margin-top: 1rem;">
          <a
            href="/documents/jack-yu-resume.pdf"
            download
            style="color: dodgerblue; text-decoration: underline;"
          >
            Download PDF
          </a>
        </p>
      </div>
    </section>
  </div>
</Layout>
