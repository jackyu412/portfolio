---
import Layout from "../layouts/Layout.astro";
import Lightbox from "../components/Lightbox.tsx";
import SectionPanel from "../components/SectionPanel.astro";
---

<Layout title="Creative | Jack Yu" description="Creative work by Jack Yu">
  <div class="content-wrapper">
    <SectionPanel>
      <ul class="creative-list">
        <li class="creative-entry">
          <div class="creative-entry-header">
            <h3>Granados — Allegro de Concierto in D Major, Op. 46</h3>
            <span class="entry-date">2025</span>
          </div>
          <p>Recorded after my senior year of high school.</p>
          <p>
            <a
              href="https://www.youtube.com/watch?v=nbd7ltlcINk"
              target="_blank"
              rel="noopener noreferrer"
            >
              Watch on YouTube →
            </a>
          </p>
        </li>
        <li class="creative-entry">
          <div class="creative-entry-header">
            <h3>Fields</h3>
            <span class="entry-date">2024</span>
          </div>
          <p>
            Layered printwork contextualizing history of light, with historical
            imagery of light as rays with overlaid interference patterns. Made
            via acetone phototransfer, matplotlib, and inkjet. Acquired by
            Albuquerque Academy for their permanent collection.
          </p>
          <Lightbox
            src="/images/fieldscompressed.jpg"
            fullSizeSrc="/images/fields.jpg"
            alt="Fields printmaking piece"
            client:load
          />
        </li>

        <li class="creative-entry">
          <div class="creative-entry-header">
            <h3>3-in-1 Magnetic Ruler Clip</h3>
            <span class="entry-date">2024</span>
          </div>
          <p>
            A compact magnetic clip for marking, depth-gauging, and precision
            measurement. I found this useful when making technical drawings on a
            sheet of paper.
          </p>
          <div class="iframe-wrapper">
            <iframe
              src="https://www.printables.com/embed/1403182"
              title="3-in-1 Magnetic Ruler Clip on Printables"
              width="400"
              height="445"
              loading="lazy"
              scrolling="no"
              frameborder="0"></iframe>
          </div>
        </li>
      </ul>
    </SectionPanel>
  </div>
</Layout>
