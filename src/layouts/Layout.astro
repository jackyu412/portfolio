---
import CrtBackground from "../components/CrtBackground.astro";
const {
  title = "Jack Yu | Physics at Caltech",
  description = "Jack Yu is a Caltech physics student working across experimental and computational physics.",
  showBackground = true,
  gain = 0.34,
  noIndex = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const site = Astro.site ?? new URL("https://jacksyu.com");
const canonical = new URL(currentPath, site);
const now = new Date();
const localTime = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Los_Angeles",
  hour: "numeric",
  minute: "2-digit",
})
  .format(now)
  .toLowerCase();
const localDate = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Los_Angeles",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
})
  .format(now)
  .replaceAll("-", ".");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f4f2ec" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/images/headshot.webp", site)}
    />
    <link rel="icon" href="/images/qwell.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/SchibstedGrotesk-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body>
    {
      showBackground && (
        <CrtBackground
          gain={gain}
          selectors=".sidebar, .content-column h1, .content-column p"
        />
      )
    }
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-layout">
      <header class="sidebar">
        <a class="wordmark" href="/">Jack Yu</a>
        <nav class="primary-nav" aria-label="Primary">
          <a
            href="/research"
            aria-current={currentPath === "/research" ? "page" : undefined}
            >research</a
          >
          <a
            href="/resume"
            aria-current={currentPath === "/resume" ? "page" : undefined}
            >resume</a
          >
          <a
            href="/contact"
            aria-current={currentPath === "/contact" ? "page" : undefined}
            >contact</a
          >
          <a
            href="/misc"
            aria-current={currentPath === "/misc" ? "page" : undefined}
            >misc</a
          >
        </nav>
        <button
          class="clock-toggle"
          type="button"
          aria-expanded="false"
          aria-label="Show local date"
        >
          <span class="clock-time tabular-numbers">pasadena · {localTime}</span>
          <span class="clock-date tabular-numbers" hidden
            >caltech · {localDate}</span
          >
        </button>
      </header>
      <main id="main-content" class="content-column">
        <slot />
        <footer class="content-footer">
          <section
            class="contact-note"
            aria-labelledby="contact-label"
            data-email-reveal
          >
            <p class="contact-label" id="contact-label">contact</p>
            <button
              class="email-show"
              type="button"
              aria-expanded="false"
            >show email</button>
            <div class="email-results" aria-live="polite" hidden></div>
            <noscript>
              <p>
                jackyu [at] caltech [dot] edu<br />jack.yu [at] ligo [dot] org
              </p>
            </noscript>
          </section>
          <p class="site-credit">© {now.getFullYear()} Jack Yu</p>
        </footer>
      </main>
    </div>
    <script>
      import "../scripts/clock.js";
      import "../scripts/site-controls.js";
    </script>
  </body>
</html>
