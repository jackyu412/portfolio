---
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

// Accept title and description as props
const { title = 'Jack Yu', description = 'Portfolio of Jack Yu – Physics student at Caltech, photonics researcher, and creative.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="images/qwell.png" type="image/png" />
    <link rel="stylesheet" href="/global.css" />
    <style>
      html, body { background-color: #f0f4f8; }
    </style>
  </head>
  <body>
    <ViewTransitions />
    <header data-astro-transition-persist>
      <Hero name="Jack Yu" title="Freshman at Caltech majoring in Physics" />
      <Nav />
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <p>© {new Date().getFullYear()} Jack Yu</p>
    </footer>
    <Analytics />
  </body>
</html>
