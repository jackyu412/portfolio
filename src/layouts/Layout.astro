---
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.jsx";

// Accept title and description as props
const { title = "Jack Yu", description = "Portfolio of Jack Yu" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/qwell.svg" type="image/svg" />
    <link rel="stylesheet" href="/global.css" />
  </head><body>
    <Hero name="Jack Yu" title="Freshman at Caltech majoring in Physics" />

    <!-- Navigation appears first -->
    <Nav client:load />

    <!-- Page-specific content -->
    <main>
      <slot />
    </main>

    <footer class="footer">
      <p>© {new Date().getFullYear()} Jack Yu</p>
    </footer>
  </body>
</html>
