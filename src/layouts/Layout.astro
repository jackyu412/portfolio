---
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.jsx";
import background from "../assets/output-background.webp";

// Accept title and description as props
const {
  title = "Jack Yu",
  description = "Portfolio of Jack Yu",
  heroTitle = "",
} = Astro.props;
---

<html lang="en" style={`--bg-image:url('${background.src}')`}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/qwell.svg" type="image/svg" />
    <link rel="preload" as="image" href={background.src} fetchpriority="high" />
    <link
      rel="preload"
      as="font"
      href="/fonts/lmroman10-regular.woff2"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      href="/fonts/lmroman10-bold.woff2"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" as="style" href="/global.css" />
    <style>
      html {
        background-color: #111;
      }

      body {
        background-color: #111;
        background-image: var(--bg-image);
        background-size: cover;
        background-position: center -5%;
        background-repeat: no-repeat;
        background-attachment: fixed;
        color: #111;
      }
    </style>
    <link rel="stylesheet" href="/global.css" />
  </head><body>
    <Hero name="Jack Yu" title={heroTitle} />

    <!-- Navigation appears first -->
    <Nav client:idle />

    <!-- Page-specific content -->
    <main>
      <slot />
    </main>

    <footer class="footer">
      <p>© {new Date().getFullYear()} Jack Yu</p>
    </footer>
  </body>
</html>
