---
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.jsx';

// Accept title and description as props
const { 
  title = 'Jack Yu', 
  description = 'Portfolio of Jack Yu – Physics student at Caltech, photonics researcher, and creative.' 
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/qwell.png" type="image/png" />
    <link rel="stylesheet" href="/global.css" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/fields.jpg" />
    <meta property="og:url" content="https://yourdomain.com/" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/fields.jpg" />
  </head>
  <body>
    <!-- Navigation appears first -->
    <Nav client:load />

    <!-- Hero section comes below the nav -->
    <Hero name="Jack Yu" title="Freshman at Caltech majoring in Physics" />

    <!-- Page-specific content -->
    <main>
      <slot />
    </main>

    <footer class="footer">
      <p>© {new Date().getFullYear()} Jack Yu</p>
    </footer>
  </body>
</html>
