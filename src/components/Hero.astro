---
const { name = "Jack Yu", title = "Freshman at Caltech majoring in Physics" } = Astro.props;
---

<section class="hero">
  <a href="/" class="hero-link" aria-label="Go to homepage">
    <h1>{name}</h1>
    <p>{title}</p>
  </a>
</section>

<style>
.hero {
  text-align: center;
  padding: 2rem 0 1rem 0;
  font-family: 'Latin Modern Roman', serif;
}
.hero h1 {
  margin: 0;
  font-weight: 700;
}
.hero p {
  margin: 0.5rem 0 0 0;
  font-weight: 400;
  font-style: italic;
}
.hero-link {
  color: inherit;
  text-decoration: none;
  display: inline-block;
}
.hero-link:hover {
  text-decoration: underline;
}
</style>