---
const {
  gain = 0.34,
  cell = 3.8,
  selectors = ".sidebar, .content-column h1, .content-column p",
} = Astro.props;
---

<canvas
  id="crt-bg"
  class="ambient-canvas"
  aria-hidden="true"
  data-gain={gain}
  data-cell={cell}
  data-selectors={selectors}></canvas>

<style is:global>
  #crt-bg {
    position: fixed;
    z-index: -1;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  #crt-bg[hidden] {
    display: none;
  }

  @media print {
    #crt-bg {
      display: none;
    }
  }
</style>

<script src="../scripts/crt-background.ts"></script>
